{
  "extends": "@openspace/shared-configs/tsconfig.vite.json",

  "compilerOptions": {
    "composite": true,
    "paths": {
      "@/api/*": ["./src/api/*"],
      "@/components/*": ["./src/components/*"],
      "@/config/*": ["./src/config/*"],
      "@/firebase/*": ["./src/firebase/*"],
      "@/icons/*": ["./src/icons/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/pages/*": ["./src/pages/*"],
      "@/redux/*": ["./src/redux/*"],
      "@/types/*": ["./src/types/*"],
      "@/utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src"]
}
